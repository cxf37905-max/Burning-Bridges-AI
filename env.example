# -----------------------------------------------------------------------------
# Application BASE URL
# https://mksaas.com/docs/env#core-configuration
# 生产环境使用本站域名；本地开发可以改为 http://localhost:3000。
# For development, set to http://localhost:3000 or any other port
# For payment test env, you can try https://hostc.dev for proxy
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="https://burningbridgesai.cc"

# -----------------------------------------------------------------------------
# Database
# https://mksaas.com/docs/database
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Better Auth
# https://mksaas.com/docs/auth
# Generate a random string for the secret key using `openssl rand -base64 32`
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Github OAuth
# https://mksaas.com/docs/auth#2-configure-github-oauth
# https://www.better-auth.com/docs/authentication/github
# Get Client information from https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# https://mksaas.com/docs/auth#3-configure-google-oauth
# https://www.better-auth.com/docs/authentication/google
# Get Client information from https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email / Newsletter (Resend)
# https://mksaas.com/docs/email
# https://mksaas.com/docs/newsletter
# Get API key from https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Newsletter (Beehiiv)
# https://mksaas.com/docs/newsletter
# Get API key from https://app.beehiiv.com/settings/integrations
# -----------------------------------------------------------------------------
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2 or S3-compatible service of your choice)
# https://mksaas.com/docs/storage
# Cloudflare R2: https://www.cloudflare.com/developer-platform/products/r2
# -----------------------------------------------------------------------------
# 生产使用独立私有桶和仅限该桶的对象读写凭据；端点不包含桶名。
# 在R2桶设置中配置生命周期：studio-inputs/满1天删除，studio-results/满15天删除。
# 站内成片访问仍为14天；生命周期由R2后台执行，不需要外部删除任务。
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
# 用户媒体桶保持私有，此项留空，不启用r2.dev或公共自定义域名。
STORAGE_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Payment Provider
# 可选值：'stripe'、'creem'、'paypal'、'waffo'、'dodo'；本站默认使用 'dodo'
# 切换后本地重启 pnpm dev，部署站重新构建部署，前后端与政策名称才会统一更新。
# Controls which payment provider is used and which price/product IDs are read
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_PROVIDER="dodo"

# -----------------------------------------------------------------------------
# Payment (Stripe)
# https://mksaas.com/docs/payment
# Get Stripe key and secret from https://dashboard.stripe.com
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pro plan - monthly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
# Pro plan - yearly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
# Lifetime plan - one-time payment
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=""
# Credit package - basic
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_BASIC=""
# Credit package - standard
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_STANDARD=""
# Credit package - premium
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_PREMIUM=""
# Credit package - enterprise
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_ENTERPRISE=""

# -----------------------------------------------------------------------------
# Payment (Creem) - alternative provider to Stripe
# https://docs.creem.io
# Set NEXT_PUBLIC_PAYMENT_PROVIDER='creem' to enable
# Get API key and webhook secret from https://creem.io dashboard
# CREEM_DEBUG=true uses test-api.creem.io (sandbox); false uses production
# -----------------------------------------------------------------------------
CREEM_DEBUG="true"
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# Pro plan - monthly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_PRO_MONTHLY=""
# Pro plan - yearly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_PRO_YEARLY=""
# Lifetime plan - one-time payment (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_LIFETIME=""
# Credit package - basic (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_CREDITS_BASIC=""
# Credit package - standard (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_CREDITS_STANDARD=""
# Credit package - premium (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_CREDITS_PREMIUM=""
# Credit package - enterprise (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_CREDITS_ENTERPRISE=""

# -----------------------------------------------------------------------------
# 支付方式（PayPal）
# 将 NEXT_PUBLIC_PAYMENT_PROVIDER 设为 "paypal" 后启用
# 月付、年付填写 PayPal 订阅计划 ID
# 一次性支付填写站内订单标识，并非 PayPal 后台的产品或价格 ID
# -----------------------------------------------------------------------------
PAYPAL_SANDBOX="true"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Pro 套餐月付（PayPal 订阅计划 ID）
NEXT_PUBLIC_PAYPAL_PLAN_PRO_MONTHLY=""
# Pro 套餐年付（PayPal 订阅计划 ID）
NEXT_PUBLIC_PAYPAL_PLAN_PRO_YEARLY=""
# 终身套餐（站内订单标识）
NEXT_PUBLIC_PAYPAL_PRICE_LIFETIME="paypal_lifetime"
# 基础积分包（站内订单标识）
NEXT_PUBLIC_PAYPAL_PRICE_CREDITS_BASIC="paypal_credits_basic"
# 标准积分包（站内订单标识）
NEXT_PUBLIC_PAYPAL_PRICE_CREDITS_STANDARD="paypal_credits_standard"
# 高级积分包（站内订单标识）
NEXT_PUBLIC_PAYPAL_PRICE_CREDITS_PREMIUM="paypal_credits_premium"
# 企业积分包（站内订单标识）
NEXT_PUBLIC_PAYPAL_PRICE_CREDITS_ENTERPRISE="paypal_credits_enterprise"

# -----------------------------------------------------------------------------
# Configurations
# -----------------------------------------------------------------------------
# Disable image optimization, check out next.config.ts for more details
# -----------------------------------------------------------------------------
DISABLE_IMAGE_OPTIMIZATION=false
# -----------------------------------------------------------------------------
# Analytics
# https://mksaas.com/docs/analytics
# -----------------------------------------------------------------------------
# Google Analytics (https://analytics.google.com)
# https://mksaas.com/docs/analytics#google
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# -----------------------------------------------------------------------------
# Umami Analytics (https://umami.is)
# https://mksaas.com/docs/analytics#umami
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
# -----------------------------------------------------------------------------
# OpenPanel Analytics (https://openpanel.dev)
# https://mksaas.com/docs/analytics#openpanel
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
# -----------------------------------------------------------------------------
# Plausible Analytics (https://plausible.io)
# https://mksaas.com/docs/analytics#plausible
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
# -----------------------------------------------------------------------------
# Ahrefs Analytics (https://ahrefs.com)
# https://mksaas.com/docs/analytics#ahrefs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AHREFS_WEBSITE_ID=""
# -----------------------------------------------------------------------------
# Seline Analytics
# https://mksaas.com/docs/analytics#seline
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SELINE_TOKEN=""
# -----------------------------------------------------------------------------
# DataFast Analytics (https://datafa.st)
# https://mksaas.com/docs/analytics#datafast
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN=""
# -----------------------------------------------------------------------------
# Clarity Analytics (https://clarity.microsoft.com)
# https://mksaas.com/docs/analytics#clarity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=""


# -----------------------------------------------------------------------------
# Notification (Discord)
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
# -----------------------------------------------------------------------------
# Notification (Feishu)
# -----------------------------------------------------------------------------
FEISHU_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# Affiliate
# https://mksaas.com/docs/affiliate
# -----------------------------------------------------------------------------
# Affonso
# https://affonso.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_AFFONSO_ID=""
# -----------------------------------------------------------------------------
# PromoteKit
# https://www.promotekit.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_PROMOTEKIT_ID=""

# -----------------------------------------------------------------------------
# Crisp
# https://mksaas.com/docs/chatbox
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CRISP_WEBSITE_ID=""

# -----------------------------------------------------------------------------
# Credit distribution via Cron Jobs
# https://mksaas.com/docs/cronjobs
# -----------------------------------------------------------------------------
CRON_JOBS_USERNAME=""
CRON_JOBS_PASSWORD=""

# -----------------------------------------------------------------------------
# AI
# https://mksaas.com/docs/ai
# -----------------------------------------------------------------------------
# DeepSeek: https://platform.deepseek.com/api_key
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=""
# -----------------------------------------------------------------------------
# OpenAI GPT: https://platform.openai.com/api-key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Web Content Analyzer (Firecrawl)
# https://firecrawl.dev/
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=""

# Burning Bridges AI：服务端配置，不能放入 NEXT_PUBLIC_ 变量
FAL_KEY=""
# 模型完成回调的公网HTTPS地址；本地填现有隧道域名，不修改localhost登录地址。
# 正式HTTPS站点可留空，默认使用NEXT_PUBLIC_BASE_URL。
FAL_WEBHOOK_BASE_URL=""
# fal Key 仅用于两段 Kling O3 Edit；拼接与加音频在服务端本地执行。
STUDIO_KLING_TIER="standard"
# 可选：自定义服务器 FFmpeg 可执行文件绝对路径；默认使用随依赖安装的二进制。
FFMPEG_PATH=""
# 后台每分钟推进分段任务；Vercel Cron 或外部调度器使用 Bearer 鉴权，至少32字符。
CRON_SECRET=""
# 真实样片、支付沙箱、政策与成本验证完成后才开启
STUDIO_LAUNCH_READY="false"

# Waffo Pancake：与最新版模板使用同一个支付接口
# https://docs.waffo.ai/zh/
# 测试 true，生产 false；私钥、商店和产品必须属于同一环境。
# 私钥使用完整 RSA PEM，可用 \n 表示换行；验签公钥由官方 SDK 提供。
# 在 Waffo 后台配置：https://测试站域名/api/webhooks/waffo
# 订阅 order.completed、refund.succeeded，回调地址必须可从公网访问。
# 本地登录保留 NEXT_PUBLIC_BASE_URL=http://localhost:3000。
# 测试付款可单独填写 HTTPS 隧道地址；付款后经隧道返回 localhost。
# 此变量仅在 WAFFO_DEBUG=true 时使用，正式环境留空。
WAFFO_RETURN_BASE_URL=""
WAFFO_DEBUG="true"
WAFFO_MERCHANT_ID=""
WAFFO_PRIVATE_KEY=""
WAFFO_STORE_ID=""
# 四档均创建一次性 USD 产品，金额必须和本站完全一致。
# Single：$9.90，100 积分，1 个视频
NEXT_PUBLIC_WAFFO_PRODUCT_CREDITS_BASIC=""
# Starter：$19.90，300 积分，3 个视频
NEXT_PUBLIC_WAFFO_PRODUCT_CREDITS_STANDARD=""
# Creator：$49.90，900 积分，9 个视频
NEXT_PUBLIC_WAFFO_PRODUCT_CREDITS_PREMIUM=""
# Pro：$89.90，1800 积分，18 个视频
NEXT_PUBLIC_WAFFO_PRODUCT_CREDITS_ENTERPRISE=""

# -----------------------------------------------------------------------------
# 支付方式（Dodo Payments）
# https://docs.dodopayments.com/introduction
# 将 NEXT_PUBLIC_PAYMENT_PROVIDER 设为 "dodo" 后启用；以下七项均填写 Dodo 产品 ID
# DODO_DEBUG=true 使用测试环境；false 使用生产环境，API Key、Webhook Key 和产品 ID 必须匹配环境
# 回调地址：https://你的域名/api/webhooks/dodo（订阅 payment.*、subscription.*、refund.*）
# 订阅产品的付款频率设为月/年，总订阅期限须长于单次账期，否则到期后不会自动续费
# -----------------------------------------------------------------------------
DODO_DEBUG="false"
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# Pro 套餐月付（订阅产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_PRO_MONTHLY=""
# Pro 套餐年付（订阅产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_PRO_YEARLY=""
# 终身套餐（一次性产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_LIFETIME=""
# 基础积分包（一次性产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_CREDITS_BASIC=""
# 标准积分包（一次性产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_CREDITS_STANDARD=""
# 高级积分包（一次性产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_CREDITS_PREMIUM=""
# 企业积分包（一次性产品 ID）
NEXT_PUBLIC_DODO_PRODUCT_CREDITS_ENTERPRISE=""
